# Ghostmaxxing backend production environment
#
# Intended for the ghostmaxxing.vecna.eu server. Copy this file to `env`, fill
# in the credential placeholders below, and keep `env` out of version control:
#
#   cp .env.example env
#
# `npm start`, `npm run serve`, `npm run dev`, and `npm run debug` load `env`
# (without a leading dot). A systemd deployment should reference that same file
# with EnvironmentFile=/absolute/path/to/gstmxx-backend/env.
# Values are not shell-expanded: use complete literal paths and URLs.

# ---------------------------------------------------------------------------
# Runtime and listener
# ---------------------------------------------------------------------------

# Production mode. No application default; Node otherwise leaves it unset.
NODE_ENV=production

# nginx on the same server proxies to this listener. Application defaults are
# HOST=0.0.0.0 and PORT=4040; loopback is safer behind nginx.
HOST=127.0.0.1
PORT=4040

# ---------------------------------------------------------------------------
# Public identity — required for real federation
# ---------------------------------------------------------------------------

# Canonical public origin embedded in actor IDs, posts, keys and signatures.
# Default: http://127.0.0.1:<PORT>. Never use that default in production.
GSTMXX_PUBLIC_URL=https://ghostmaxxing.vecna.eu

# Fail startup if the public identity is private or otherwise non-federable.
# Default: false. This should be true on the production server.
GSTMXX_STRICT_ORIGIN=1

# Local control endpoint used by manual scripts. Default:
# http://127.0.0.1:<PORT>. Keeping it explicit avoids TLS/nginx hairpinning.
LAB_API_URL=http://127.0.0.1:4040

# Historical public-origin alias. Leave unset because GSTMXX_PUBLIC_URL wins.
# LAB_BASE_URL=https://ghostmaxxing.vecna.eu

# Development/LAN acknowledgement only. Default: false. Never enable this to
# work around a production identity problem; it only suppresses a warning.
# GSTMXX_ALLOW_PRIVATE_ORIGIN=1

# ---------------------------------------------------------------------------
# Secrets — replace both placeholders before starting production
# ---------------------------------------------------------------------------

# Bearer token for post creation, announcements, profile editing and digest
# controls. The code's development fallback is `big-oopsie`; never rely on it.
LAB_POST_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Basic Auth for /api/admin and the staff composer. Defaults are `admin` and
# `change-me-now-2026`; both must be replaced in production.
GSTMXX_ADMIN_USER=REPLACE_WITH_ADMIN_USERNAME
GSTMXX_ADMIN_PASS=REPLACE_WITH_A_LONG_RANDOM_SECRET

# ---------------------------------------------------------------------------
# Persistent paths
# ---------------------------------------------------------------------------

# Defaults, when omitted, are <repository>/data and <repository>/storage.
# Absolute paths are recommended in production. The storage path below matches
# nginx/ghostmaxxing.vecna.eu.conf and its /videos, /clipboard and /thumbnails
# aliases. Ensure the service user can read/write both directories.
LAB_DATA_DIR=/var/www/ghostmaxxing/backend/data
GSTMXX_STORAGE_DIR=/var/www/ghostmaxxing/backend/storage

# Optional single-process static client path. Production nginx already serves
# /var/www/ghostmaxxing/client-interface directly, so the backend does not need
# this setting there. Enable it when Node should serve the staged client too.
# GSTMXX_CLIENT_INTERFACE_DIR=/var/www/ghostmaxxing/client-interface
# LAB_CLIENT_INTERFACE_DIR is the legacy alias; GSTMXX_CLIENT_INTERFACE_DIR wins.

# ---------------------------------------------------------------------------
# Public upload and background-work defaults
# ---------------------------------------------------------------------------

# Per-IP POST /api/uploads limit. Application defaults shown here.
GSTMXX_UPLOAD_RATE_WINDOW_MS=900000
GSTMXX_UPLOAD_RATE_MAX=20

# Delete pending, unmoderated uploads after this many days. Default: 14.
GSTMXX_STALE_DAYS=14

# Check scheduled digest actors every five minutes. Default: 300000.
GSTMXX_DIGEST_INTERVAL_MS=300000

# Retry deferred Follow Accept delivery every minute, at most 12 attempts.
# Defaults: 60000 and 12.
GSTMXX_ACCEPT_RETRY_INTERVAL_MS=60000
GSTMXX_ACCEPT_MAX_ATTEMPTS=12

# Enabled filter actors. This is the exact application default. Remove this
# line to inherit the same list from the code.
GSTMXX_FILTERS=ghostyles-pictures,ghostyles-video,ghostyles-daily,ghostyles-weekly,ghostyles-top-rated

# ---------------------------------------------------------------------------
# Optional diagnostics
# ---------------------------------------------------------------------------

# Uncomment for request/state/federation diagnostics. Default: disabled.
# DEBUG=gstmxx:flow,gstmxx:http,gstmxx:store,gstmxx:activitypub

# Manual CLI tools normally read ./fedibasic.env unless --env-file is passed.
# Point them at the production env file if those tools should reuse it.
# FEDIBASIC_ENV_FILE=/var/www/ghostmaxxing/backend/env

# Test-only variables — NEVER set these in production:
# GSTMXX_MOCK_VIDEO_PROCESSING=1
# GSTMXX_MOCK_FFPROBE=video
# GSTMXX_CYCLE_TRACE=0
