@@ -0,0 +1,62 @@
+import crypto from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+
+function ensureDirectory(directory) {
+  fs.mkdirSync(directory, { recursive: true });
+}
+
+function postPath(postsDirectory, id) {
+  if (!/^[0-9a-f-]{36}$/i.test(id)) return null;
+  return path.join(postsDirectory, `${id}.json`);
+}
+
+export function createPostStore(postsDirectory) {
+  ensureDirectory(postsDirectory);
+
+  function read(id) {
+    const filePath = postPath(postsDirectory, id);
+    if (!filePath) return null;
+    try {
+      return JSON.parse(fs.readFileSync(filePath, "utf8"));
+    } catch (error) {
+      if (error.code === "ENOENT") return null;
+      throw error;
+    }
+  }
+
+  function list() {
+    return fs
+      .readdirSync(postsDirectory, { withFileTypes: true })
+      .filter((entry) => entry.isFile() && /^[0-9a-f-]{36}\.json$/i.test(entry.name))
+      .map((entry) => read(path.basename(entry.name, ".json")))
+      .filter(Boolean)
+      .sort((left, right) => right.createdAt.localeCompare(left.createdAt));
+  }
+
+  function create({ content, actor = "video" }) {
+    if (typeof content !== "string") {
+      throw new TypeError("Post content must be a string.");
+    }
+    if (content.length === 0) {
+      throw new TypeError("Post content must not be empty.");
+    }
+
+    const post = {
+      id: crypto.randomUUID(),
+      type: "Note",
+      actor,
+      content,
+      createdAt: new Date().toISOString()
+    };
+    const finalPath = postPath(postsDirectory, post.id);
+    const temporaryPath = `${finalPath}.${process.pid}.tmp`;
+    fs.writeFileSync(temporaryPath, `${JSON.stringify(post, null, 2)}\n`, {
+      flag: "wx"
+    });
+    fs.renameSync(temporaryPath, finalPath);
+    return post;
+  }
+
+  return { create, list, read, directory: postsDirectory };
+}
