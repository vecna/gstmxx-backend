{
  "name": "ghostmaxxing-backend",
  "version": "1.0.0",
  "private": true,
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "fedibasic:start": "node fedibasic-server.js",
    "fedibasic:dev": "node --watch fedibasic-server.js",
    "fedibasic:test": "node --test fedibasic-test/smoke.test.js",
    "fedibasic:tunnel": "fedify tunnel ${PORT:-4040}",
    "fediverse:static": "node fediverse-static/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:online": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.online.config.js",
    "c2p": "code2prompt --exclude node_modules --exclude .git --exclude .vscode --exclude .idea --exclude .husky --exclude .github --exclude .gitignore --exclude package-lock.json -O c2p-`date -I`.txt"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fedify/cli": "^2.3.3",
    "@fedify/fedify": "^1.5.9",
    "@js-temporal/polyfill": "^0.5.1",
    "better-sqlite3": "^11.0.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "jest": "^30.4.2"
  }
}
