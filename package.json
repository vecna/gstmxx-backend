{
  "name": "ghostmaxxing-backend",
  "version": "1.3.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=env server.js",
    "dev": "node --watch --env-file-if-exists=env server.js",
    "debug": "DEBUG=gstmxx:flow,gstmxx:http,gstmxx:store,gstmxx:activitypub node --env-file-if-exists=env server.js",
    "test": "node --test $(find test -maxdepth 1 -name '*.test.js' ! -name 'openapi.full-cycle.test.js' | sort)",
    "test:full-cycle": "node --test test/openapi.full-cycle.test.js",
    "test:coverage": "c8 --reporter=text --reporter=text-summary --reporter=lcov node --test $(find test -maxdepth 1 -name '*.test.js' ! -name 'openapi.full-cycle.test.js' | sort)",
    "tunnel": "npx --yes @fedify/cli tunnel ${PORT:-4040}",
    "post": "node manual-add-post.js",
    "quote-picture": "node manual-quote-picture.js",
    "profile": "node manual-profile.js",
    "doctor": "node -e \"fetch(process.env.LAB_API_URL||'http://127.0.0.1:'+(process.env.PORT||4040)+'/healthz').then(r=>r.json()).then(j=>console.log(JSON.stringify(j,null,2)))\"",
    "c2p": "code2prompt --exclude node_modules --exclude .git --exclude .vscode --exclude .idea --exclude .husky --exclude .github --exclude .gitignore --exclude package-lock.json -O c2p-`date -I`.txt"
  },
  "engines": {
    "node": ">=20.16.0"
  },
  "dependencies": {
    "@fedify/fedify": "^1.5.9",
    "@js-temporal/polyfill": "^0.5.1",
    "debug": "^4.3.4",
    "express": "^4.21.2",
    "express-rate-limit": "^7.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@fedify/cli": "^2.3.3",
    "c8": "^12.0.0",
    "fast-xml-parser": "^4.4.1"
  },
  "overrides": {
    "@opentelemetry/core": ">=2.8.0"
  }
}

