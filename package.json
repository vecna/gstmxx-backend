{
  "name": "ghostmaxxing-backend",
  "version": "1.2.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "debug": "DEBUG=gstmxx:flow,gstmxx:http,gstmxx:store,gstmxx:activitypub node --env-file-if-exists=env server.js",
    "test": "node --test",
    "tunnel": "fedify tunnel ${PORT:-4040}",
    "post": "node manual-add-post.js",
    "quote-picture": "node manual-quote-picture.js",
    "test:legacy": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "c2p": "code2prompt --exclude node_modules --exclude .git --exclude .vscode --exclude .idea --exclude .husky --exclude .github --exclude .gitignore --exclude package-lock.json -O c2p-`date -I`.txt"
  },
  "engines": {
    "node": ">=20.16.0"
  },
  "dependencies": {
    "@fedify/cli": "^2.3.3",
    "@fedify/fedify": "^1.5.9",
    "@js-temporal/polyfill": "^0.5.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "debug": "^4.3.4",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "fast-xml-parser": "^4.4.1",
    "jest": "^30.4.2"
  }
}
