# Copy to `env` and edit. Loaded by `npm run debug` via --env-file-if-exists=env.

# The HTTP socket. 0.0.0.0 also permits access from another device on your LAN.
HOST=0.0.0.0
PORT=4040

# The stable public ActivityPub identity embedded in actor and post IDs.
# It must be the HTTPS origin that Mastodon can reach; it is not the CLI target.
# Same Linux machine:
LAB_BASE_URL=http://127.0.0.1:4040
#
# Browser on another LAN machine (example):
# LAB_BASE_URL=http://192.168.1.50:4040
#
# Real fediverse testing (public host from your tunnel):
# LAB_BASE_URL=https://the-public-host-returned-by-your-tunnel.example

# The CLI control route. Keep this local even when LAB_BASE_URL is public,
# to avoid DNS hairpin, TLS, proxy, and firewall surprises.
LAB_API_URL=http://127.0.0.1:4040

# Runtime state directory. Defaults to ./data (posts/, keys.json,
# followers.json, fedify-kv.json). Back this up — keys.json + followers.json
# are the federated identity.
# LAB_DATA_DIR=/var/lib/ghostmaxxing/data

# Serve the real client from a custom directory (top-priority static layer).
# In production nginx serves the client; this is the single-process dev path.
# LAB_CLIENT_INTERFACE_DIR=/absolute/path/to/client-interface
# GSTMXX_CLIENT_INTERFACE_DIR=/absolute/path/to/client-interface

# Recommended whenever the lab is reachable from the internet. Protects post
# creation and announcement; reading posts remains public.
LAB_POST_TOKEN="random-string-to-prevent-unauthorized-posts"
