# Copy to `env` and edit. Loaded by `npm run debug` via --env-file-if-exists=env.
#
# systemd users: --env-file-if-exists only applies to `npm run debug`. Under a
# unit file you must set these with EnvironmentFile=/home/gstmxx/gstmxx-backend/env
# or the process starts with none of them and silently falls back to defaults.

# The HTTP socket. 0.0.0.0 also permits access from another device on your LAN.
HOST=0.0.0.0
PORT=4040

# ---------------------------------------------------------------------------
# THE PUBLIC ACTIVITYPUB IDENTITY.  Get this wrong and federation dies quietly.
# ---------------------------------------------------------------------------
# This origin is stamped into every actor id, every activity id, every object
# id and - critically - into the signing key id:
#
#     <origin>/federation/actors/<handle>#main-key
#
# A remote server MUST be able to fetch that URL to verify our HTTP signature.
# If this is 127.0.0.1 or a LAN address, Mastodon refuses to dial it, answers
# 401 with PrivateNetworkAddressError, and every Follow and every publish fails
# with a 500 on our side. It is NOT the address the process listens on and it
# is NOT the address the CLI talks to.
#
# Production: the HTTPS origin the world uses.
GSTMXX_PUBLIC_URL=https://ghostmaxxing.vecna.eu
#
# Local development on one machine (also set GSTMXX_ALLOW_PRIVATE_ORIGIN=1):
# GSTMXX_PUBLIC_URL=http://127.0.0.1:4040
#
# Real fediverse testing from a laptop, via a tunnel:
# GSTMXX_PUBLIC_URL=https://the-public-host-returned-by-your-tunnel.example
#
# LAB_BASE_URL is the historical name and still works as an alias. If both are
# set, GSTMXX_PUBLIC_URL wins.
# LAB_BASE_URL=https://ghostmaxxing.vecna.eu

# Acknowledge that a private origin is intentional (LAN demo, offline test).
# Only silences the boot banner; it does not make federation work.
# GSTMXX_ALLOW_PRIVATE_ORIGIN=1

# Refuse to start at all on a private origin. Recommended in production: it
# turns a silent misconfiguration into a failed deploy.
GSTMXX_STRICT_ORIGIN=1

# The CLI control route. Keep this local even when the public URL is public,
# to avoid DNS hairpin, TLS, proxy, and firewall surprises.
LAB_API_URL=http://127.0.0.1:4040

# Runtime state directory. Defaults to ./data (posts/, keys.json,
# followers.json, profiles.json, pending-accepts.json, fedify-kv.json).
# Back this up - keys.json + followers.json are the federated identity.
# LAB_DATA_DIR=/var/lib/ghostmaxxing/data

# Serve the real client from a custom directory (top-priority static layer).
# In production nginx serves the client; this is the single-process dev path.
# LAB_CLIENT_INTERFACE_DIR=/absolute/path/to/client-interface
# GSTMXX_CLIENT_INTERFACE_DIR=/absolute/path/to/client-interface

# Recommended whenever the lab is reachable from the internet. Protects post
# creation, profile editing and announcement; reading posts remains public.
LAB_POST_TOKEN="random-string-to-prevent-unauthorized-posts"

# Deferred Accept(Follow) retries. A follow whose Accept could not be delivered
# is parked in data/pending-accepts.json and retried with doubling backoff.
# GSTMXX_ACCEPT_RETRY_INTERVAL_MS=60000
# GSTMXX_ACCEPT_MAX_ATTEMPTS=12
